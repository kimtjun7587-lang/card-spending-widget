<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:id="@+id/widget_root" android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="horizontal" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1.2" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="DIGI LOCA · London" android:textColor="#DCE7F6" android:textSize="10sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_month" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#B8C6DA" android:textSize="9sp" />
        <TextView android:id="@+id/w_amount" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FFFFFF" android:textSize="22sp" android:textStyle="bold" />
    </LinearLayout>
    <TextView android:layout_width="1dp" android:layout_height="48dp" android:layout_marginHorizontal="10dp" android:background="#476487" android:text="" />
    <LinearLayout android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:orientation="vertical">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="이번 주 남은 소비 금액" android:textColor="#D6E0EC" android:textSize="9sp" />
        <TextView android:id="@+id/w_week_left" android:layout_width="wrap_content" android:layout_height="wrap_content" android:textColor="#FF8294" android:textSize="17sp" android:textStyle="bold" />
        <TextView android:id="@+id/w_day" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="2dp" android:textColor="#B8C6DA" android:textSize="9sp" />
    </LinearLayout>
    <TextView android:id="@+id/w_period" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" /><TextView android:id="@+id/w_goal" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" /><TextView android:id="@+id/w_remain" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" /><TextView android:id="@+id/w_week_plan" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" /><TextView android:id="@+id/w_percent" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" /><ProgressBar android:id="@+id/w_progress" style="?android:attr/progressBarStyleHorizontal" android:layout_width="1dp" android:layout_height="1dp" android:visibility="gone" />
</LinearLayout>

